FIRM_URL=http://127.0.0.1:4311
FIRM_SERVICE_TOKEN=

# Local Keycloak OAuth lab. Start-OAuth.bat generates ignored local credentials.
# For manual setup, set these in PowerShell; this file is not auto-loaded.
AM100_OAUTH_ENABLED=true
AM100_OAUTH_ISSUER=http://localhost:8180/realms/ethical-walls-matter
AM100_OAUTH_AUDIENCE=am100-api
AM100_OAUTH_CLIENT_ID=matterspace-vendor
AM100_OAUTH_CLIENT_SECRET=
# Set true ONLY when scripts/api.mjs is already running separately on port 4313.
AM100_EXTERNAL_API=false
AM100_SQL_SERVER=.\SQLEXPRESS
# Optional peer links when generating hosted Worker artifacts.
AM100_FIRM_SITE_URL=
AM100_VENDOR_SITE_URL=
# These are examples only. Scripts do not automatically load .env files.
